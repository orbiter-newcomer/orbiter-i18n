// Contact-model dialog resource (project extension).
// Included by Orbiter.rc; the official file only keeps the include line.

#include "ContactResources.h"

IDD_EXTRA_CONTACT DIALOGEX 0, 0, 376, 248
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Orbiter: Contact model"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Contact model",IDC_STATIC,7,7,362,96
    LTEXT           "Force solver:",IDC_STATIC,14,20,55,8
    COMBOBOX        IDC_CONTACT_SOLVER,72,18,150,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Official: explicit contact spring/damper (original behaviour).",IDC_STATIC,14,34,350,8
    LTEXT           "Implicit damping: damping force evaluated at the end of the step.",IDC_STATIC,14,44,350,8
    LTEXT           "Fully implicit: spring and damper evaluated at the end of the step.",IDC_STATIC,14,54,350,8
    GROUPBOX        "Landing gear contact",IDC_STATIC,7,108,362,52
    LTEXT           "Stiffness:",IDC_STATIC,14,122,48,8
    EDITTEXT        IDC_CONTACT_GEAR_STIFF,76,120,40,14,ES_AUTOHSCROLL
    LTEXT           "Damping ratio:",IDC_STATIC,124,122,55,8
    EDITTEXT        IDC_CONTACT_GEAR_DAMP,188,120,40,14,ES_AUTOHSCROLL
    LTEXT           "Friction:",IDC_STATIC,234,122,45,8
    EDITTEXT        IDC_CONTACT_GEAR_MU,292,120,40,14,ES_AUTOHSCROLL
    LTEXT           "Stiffness/friction 0 = original; damping ratio 0 = original damping.",IDC_STATIC,14,138,350,8
    GROUPBOX        "Hull/body contact",IDC_STATIC,7,164,362,52
    LTEXT           "Stiffness:",IDC_STATIC,14,178,48,8
    EDITTEXT        IDC_CONTACT_HULL_STIFF,76,176,40,14,ES_AUTOHSCROLL
    LTEXT           "Damping ratio:",IDC_STATIC,124,178,55,8
    EDITTEXT        IDC_CONTACT_HULL_DAMP,188,176,40,14,ES_AUTOHSCROLL
    LTEXT           "Friction:",IDC_STATIC,234,178,45,8
    EDITTEXT        IDC_CONTACT_HULL_MU,292,176,40,14,ES_AUTOHSCROLL
    LTEXT           "Stiffness/friction 0 = original; damping ratio 0 = original damping.",IDC_STATIC,14,194,350,8
    CONTROL         "",IDC_STATIC,"Static",SS_BLACKRECT,7,220,362,1
    DEFPUSHBUTTON   "OK",IDOK,7,228,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,61,228,50,14
    PUSHBUTTON      "Reset",IDC_RESET,115,228,50,14
END
