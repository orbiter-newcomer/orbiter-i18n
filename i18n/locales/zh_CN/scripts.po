# Orbiter 中文翻译（脚本显示文本）
# 由内置 Lua 脚本（Challenges 等）通过 tr() 查询；英文模式返回原文。

msgid "Flight challenge:\n\nLaunch the Delta-glider into orbit and dock\nwith the International Space Station.\nUse as little fuel as possible.\n"
msgstr "飞行挑战：\n\n将三角滑翔机发射入轨并与国际空间站对接。\n尽可能少用燃料。\n"

msgid "Flight challenge:\n\nTransfer to the moon and dock with orbiting\nwheel, Luna-Ob1. Minimize fuel use.\n"
msgstr "飞行挑战：\n\n转移到月球并与环绕的轮形站 Luna-Ob1 对接。\n尽量少用燃料。\n"

msgid "Flight challenge:\n\nAdvanced lunar transfer: Transfer to the moon\nand dock with orbiting wheel, Luna-Ob1. Minimize\nfuel use.\nThis time you need to consider plane alignments.\n"
msgstr "飞行挑战：\n\n高级月球转移：转移到月球并与环绕的轮形站 Luna-Ob1 对接。\n尽量少用燃料。\n这次你需要考虑轨道面调整。\n"

msgid "Flight challenge:\n\nThis sounds simple enough: Deorbit the glider and\nland at Kennedy Space Center, SLF Runway 33\n- without refuelling.\nTip: a direct approach is not the best strategy here.\n"
msgstr "飞行挑战：\n\n听起来很简单：让滑翔机离轨并降落在肯尼迪航天中心的 SLF 33 号跑道——不补充燃料。\n提示：直接进近在这里不是最佳策略。\n"

msgid "High score list:\n\n"
msgstr "最高分列表：\n\n"

msgid "Fuel used"
msgstr "燃料消耗"

msgid "Name"
msgstr "姓名"

msgid "No high scores yet!"
msgstr "暂无最高分记录！"

msgid "Initial propellant mass: %.2f kg\n"
msgstr "初始推进剂质量：%.2f kg\n"

msgid "Used so far: %.2f kg\n"
msgstr "已消耗：%.2f kg\n"

msgid "Fuel used: %.2f kg"
msgstr "已用燃料：%.2f kg"

msgid "Challenge completed successfully!\n"
msgstr "挑战成功完成！\n"

msgid "Total fuel expenditure: %.2f kg"
msgstr "总燃料消耗：%.2f kg"

msgid "\n\nYou made it into the high score!"
msgstr "\n\n你进入了最高分榜！"

msgid "High score: Enter your name:"
msgstr "最高分：请输入你的名字："

msgid "Could not find GL-01. Aborting"
msgstr "找不到 GL-01，正在中止。"

msgid "Could not find GL-1. Aborting"
msgstr "找不到 GL-1，正在中止。"

msgid "Wrong vessel class. Aborting"
msgstr "飞船类型错误，正在中止。"

msgid "Mission failed!"
msgstr "任务失败！"

msgid "Mission failure: hard surface impact!\n(%.2f m/s)"
msgstr "任务失败：硬着陆！\n(%.2f m/s)"

msgid "Fuel remaining:\n%.2f kg (Main) + %.2f (RCS)"
msgstr "剩余燃料：\n%.2f kg（主） + %.2f（RCS）"

msgid "\n\nDistance to target: %g km\n"
msgstr "\n\n距目标距离：%g km\n"

msgid "\n\nGround contact!"
msgstr "\n\n已接触地面！"
