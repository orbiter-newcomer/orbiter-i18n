static bool IsChineseUI()
{
	return strcmp(oapiTr("Build"), "Build") != 0;
}

static BOOL CALLBACK LocalizeChildEnglish(HWND hCtrl, LPARAM lp)
{
	wchar_t buf[512];
	GetWindowTextW(hCtrl, buf, 512);
	if (!buf[0]) return TRUE;
	const wchar_t *en = L10nEnglish(buf);
	if (en) SetWindowTextW(hCtrl, en);
	return TRUE;
}

static BOOL CALLBACK LocalizeComboEnglish(HWND hCtrl, LPARAM lp)
{
	wchar_t cls[64];
	GetClassNameW(hCtrl, cls, 64);
	if (_wcsicmp(cls, L"ComboBox") != 0) return TRUE;
	int cnt = (int)SendMessageW(hCtrl, CB_GETCOUNT, 0, 0);
	int sel = (int)SendMessageW(hCtrl, CB_GETCURSEL, 0, 0);
	for (int i = 0; i < cnt; i++) {
		wchar_t item[512];
		item[0] = 0;
		SendMessageW(hCtrl, CB_GETLBTEXT, i, (LPARAM)item);
		const wchar_t *en = L10nEnglish(item);
		if (en) {
			SendMessageW(hCtrl, CB_DELETESTRING, i, 0);
			SendMessageW(hCtrl, CB_INSERTSTRING, i, (LPARAM)en);
		}
	}
	SendMessageW(hCtrl, CB_SETCURSEL, sel, 0);
	return TRUE;
}

void VideoTab::LocalizeSetupDialogEnglish(HWND hWnd)
{
	EnumChildWindows(hWnd, LocalizeChildEnglish, 0);
	EnumChildWindows(hWnd, LocalizeComboEnglish, 0);
}

